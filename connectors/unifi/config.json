{
  "controller_url": "https://192.168.1.1",
  "site": "default",
  "api_key_env": "UNIFI_API_KEY",
  "insecure_skip_verify": true,
  "webhook_secret_env": "UNIFI_WEBHOOK_SECRET",
  "webhook_auth_mode": "hmac",
  "webhook_signature_header": "X-Unifi-Signature",
  "network": {
    "enabled": false,
    "events_path": "/proxy/network/api/s/%s/stat/event",
    "backfill_limit": 200
  },
  "protect": {
    "enabled": true,
    "events_path": "/proxy/protect/integration/v1/subscribe/events",
    "backfill_limit": 200
  },
  "rules": [
    {"match": "event:smartDetectZone", "destination": "messaging", "tags": {"priority": "review"}},
    {"match": "event:ring", "destination": "messaging", "tags": {"priority": "review"}},
    {"match": "protect", "destination": "messaging"}
  ]
}

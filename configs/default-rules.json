{
  "rules": [
    {
      "name": "instruction_override",
      "patterns": [
        "(?i)ignore\\s+(\\w+\\s+)*previous",
        "(?i)disregard\\s+(\\w+\\s+)*your\\s+instructions",
        "(?i)forget\\s+(\\w+\\s+)*your\\s+instructions",
        "(?i)new\\s+directive"
      ],
      "weight": 1.0,
      "match_type": "regex"
    },
    {
      "name": "role_reassignment",
      "patterns": [
        "(?i)you\\s+are\\s+now",
        "(?i)pretend\\s+you\\s+are",
        "(?i)your\\s+new\\s+role",
        "(?i)\\bact(?:s|ing)?\\s+as\\s+(?:(?:an?|the|my|your|our)\\s+)?(?:(?:unrestricted|unfiltered|uncensored|unlocked|jailbroken|unethical|amoral|immoral|rogue|evil|unaligned|unmoderated|unbounded|unlimited|lawless|unsafe)\\b|(?:[a-z][a-z-]*\\s+){0,2}(?:persona|chat\\s*bot|sysadmin|system\\s+administrator|superuser|root\\s+user)\\b)",
        "(?im)\\bact(?:s|ing)?\\s+as\\s+(?:(?:an?|the|my|your|our)\\s+)?(?:[a-z][a-z-]*\\s+){0,2}(?:a\\.i\\.|ai|llm|gpt-?\\d*|assistant|(?:ai|language)\\s+model|character|hacker)(?:\\s*[.,;:!?)\\]}\"\u201d\u00bb]|\\s+(?:and|but|so|then|that|who|which|with|without|from|now|instead|named|called|for|in|to|again)\\b|\\s*$)",
        "(?i)\\byou\\s+(?:will|shall|must|should|can|may|are\\s+to|need\\s+to|have\\s+to|are\\s+going\\s+to)\\s+(?:now\\s+)?(?:instead\\s+)?act\\s+as\\b",
        "(?i)(?:from\\s+now\\s+on|from\\s+here\\s+on(?:\\s+out)?|starting\\s+now|for\\s+the\\s+(?:rest|remainder)\\s+of\\s+(?:this|the)\\s+(?:conversation|session|chat|thread))[,:;]?\\s+(?:please\\s+|you\\s+(?:will|must|should)\\s+)?act\\s+as\\b",
        "(?i:\\bact(?:s|ing)?\\s+as\\s+(?:(?:an?|the|my|your|our)\\s+)?)DAN\\b",
        "(?im)^[ \\t]*(?:please\\s+|now\\s+|kindly\\s+)?act(?:ing)?\\s+as\\b"
      ],
      "weight": 1.0,
      "match_type": "regex"
    },
    {
      "name": "tool_invocation_syntax",
      "patterns": [
        "<tool>",
        "<function_call>",
        "exec:",
        "bash:",
        "```shell"
      ],
      "weight": 0.8,
      "match_type": "substring"
    },
    {
      "name": "suspicious_encoding",
      "patterns": [],
      "weight": 0.7,
      "match_type": "custom_detector",
      "detector": "encoding_anomaly"
    },
    {
      "name": "invisible_smuggling",
      "patterns": [],
      "weight": 1.0,
      "match_type": "custom_detector",
      "detector": "invisible_smuggling"
    },
    {
      "name": "prompt_template_structure",
      "patterns": [],
      "weight": 0.6,
      "match_type": "custom_detector",
      "detector": "template_structure"
    },
    {
      "name": "non_english_content",
      "patterns": [],
      "weight": 0.0,
      "match_type": "custom_detector",
      "detector": "language_detection",
      "behavior": "weight_booster",
      "boost_factor": 1.5
    }
  ],
  "quarantine_threshold": 0.8
}